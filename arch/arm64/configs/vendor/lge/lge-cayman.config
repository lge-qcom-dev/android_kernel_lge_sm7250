# Display
CONFIG_LGE_DUAL_SCREEN=y

# Input - fingerprint
CONFIG_BBK_ET713=y

# Input - touchscreen
CONFIG_LGE_TOUCH_DEX=y
CONFIG_LGE_TOUCH_FW_PATH="touch/caymanlm"
CONFIG_LGE_TOUCH_PEN=y
CONFIG_SAR_ALMF04_C2_C3_12QFN=y
CONFIG_SECURE_TOUCH_SYNAPTICS_DSX=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_RECOVERY=y
CONFIG_TOUCHSCREEN_SYNAPTICS_TCM_REFLASH=y
CONFIG_LGE_TOUCH_LGSIC_SW42902=y
CONFIG_LGE_TOUCH_LGSIC_SW49107=y

# LGE
CONFIG_MACH_LITO_CAYMANLM=y
CONFIG_MACH_LITO_CAYMANLM_LAO_COM=y
CONFIG_LGE_PM_QNOVO_QNS=y
CONFIG_LGE_MME_BUS=y
CONFIG_LGE_MME_BOOST=y
CONFIG_LGE_MME_BOOST_EBI=y
CONFIG_LGE_MME_PM_QOS_DMA_LATENCY=y
CONFIG_LGE_PM_CCD=y

# MFD
CONFIG_MFD_DW8768=y

# NFC
CONFIG_LGE_NFC_PN553=y
CONFIG_LGE_NFC_SN100X=y

# Power
CONFIG_CHARGER_IDTP9222=y
CONFIG_USE_WIRELESS_CHARGING=y

# pstore
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# TEE
CONFIG_TRUSTONIC_TRUSTED_UI=y

# USB
CONFIG_LGE_USB_DEBUGGER=y
CONFIG_LGE_USB_LATTICE_SLS11HC=y
CONFIG_LGE_USB_SBU_SWITCH=y
CONFIG_LGE_USB_DS_DIRECT_SVID=y
CONFIG_LGE_USB_MOISTURE_DETECTION_NO_UX=y
CONFIG_LGE_USB_MOISTURE_DETECTION_USB_EN=y

# Vibrator
CONFIG_TSPDRV=y
CONFIG_VIB_DW7800=y
