# Display
CONFIG_LGE_DISPLAY_BAN_CRACK_PANEL_SUPPORT=y
CONFIG_LGE_SWIVEL_HALLIC_SUPPORT=y

# Input - fingerprint
CONFIG_BBK_ET713=y

# Input - touchscreen
CONFIG_LGE_TOUCH_DEX=y
CONFIG_LGE_TOUCH_FW_PATH="touch/winglm"
CONFIG_LGE_TOUCH_PEN=y
CONFIG_SECURE_TOUCH_SYNAPTICS_DSX=y
CONFIG_LGE_TOUCH_APP_FW_UPGRADE=y
CONFIG_LGE_TOUCH_CORE_SUB=y
CONFIG_LGE_TOUCH_SUB_DEX=y
CONFIG_LGE_TOUCH_SUB_LGSIC_SW42902=y
CONFIG_LGE_TOUCH_SUB_LGSIC_SW42000=y
CONFIG_SAR_ALMF04QFN_2_3CH_NIT=y
CONFIG_LGE_SAR_CONTROLLER_USB_DETECT=y
CONFIG_LGE_TOUCH_LGSIC_SW42902_WING=y

# LGE
CONFIG_MACH_LITO_WINGLM=y
CONFIG_MACH_LITO_WINGLM_LAO_COM=y
CONFIG_LGE_PM_QNOVO_QNS_V2=y
CONFIG_LGE_MME_BUS=y
CONFIG_LGE_MME_BOOST=y
CONFIG_LGE_MME_BOOST_EBI=y
CONFIG_LGE_MME_PM_QOS_DMA_LATENCY=y
CONFIG_LGE_PM_ACTM_V2=y
CONFIG_LGE_PM_EXT_QG_V2=y

# Motor
CONFIG_LGE_MOTORS=y
CONFIG_LGE_MOTORS_STSPIN220=y

# NFC
CONFIG_LGE_NFC_PN553=y

# Power
CONFIG_CHARGER_IDTP9222_V2=y
CONFIG_USE_WIRELESS_CHARGING=y

# pstore
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Sensors
CONFIG_SENSORS_TCS3407=y
CONFIG_TCS3407_AMS_DEBUG_LOG=y

# TEE
CONFIG_TRUSTONIC_TRUSTED_UI=y

# USB
CONFIG_LGE_USB_DEBUGGER=y
CONFIG_LGE_USB_SBU_SWITCH=y
CONFIG_LGE_USB_MOISTURE_DETECTION_NO_UX=y
CONFIG_LGE_USB_MOISTURE_DETECTION_USB_EN=y

# Vibrator
CONFIG_TSPDRV=y
CONFIG_VIB_DW7914=y
