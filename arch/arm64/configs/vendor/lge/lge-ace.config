# Input - fingerprint
CONFIG_INPUT_FINGERPRINT_FPC1540=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/acelm/himax"
CONFIG_LGE_DISPLAY_RECOVERY_ESD=y
CONFIG_LGE_TOUCH_HIMAX_HX83113A=y
CONFIG_LGE_TOUCH_HIMAX_HX83113A_DEBUG=y

# LGE
CONFIG_MACH_LITO_ACELM=y
CONFIG_MACH_LITO_ACELM_LAO_COM=y
CONFIG_LGE_PM_QNOVO_QNS_V2=y
CONFIG_LGE_MME_BUS=y
CONFIG_LGE_MME_BOOST=y
CONFIG_LGE_MME_BOOST_EBI=y
CONFIG_LGE_MME_PM_QOS_DMA_LATENCY=y
CONFIG_LGE_PM_ACTM_V2=y
CONFIG_LGE_PM_EXT_QG_V2=y

# MFD
CONFIG_MFD_DW8768=y

# NFC
CONFIG_LGE_NFC_PN553=y

# pstore
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# TEE
CONFIG_TRUSTONIC_TRUSTED_UI=y

# USB
CONFIG_LGE_USB_DEBUGGER=y
CONFIG_LGE_USB_SBU_SWITCH=y
CONFIG_LGE_USB_MOISTURE_DETECTION_NO_UX=y
CONFIG_LGE_USB_MOISTURE_DETECTION_USB_EN=y
