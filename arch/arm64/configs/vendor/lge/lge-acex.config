# Input - fingerprint
CONFIG_INPUT_FINGERPRINT_FPC1540=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/acexlm"
CONFIG_LGE_TOUCH_APP_FW_UPGRADE=y
CONFIG_SAR_ALMF04QFN_2_3CH_NIT=y
CONFIG_SAR_2nd_ALMF04QFN_2_3CH_NIT=y
CONFIG_LGE_SAR_CONTROLLER_USB_DETECT=y
CONFIG_LGE_TOUCH_FOCALTECH_FT8756=y

# LGE
CONFIG_MACH_LAGOON_ACEXLM=y
CONFIG_MACH_LAGOON_ACEXLM_LAO_COM=y
CONFIG_LGE_PM_QNOVO_QNS_V2=y
CONFIG_LGE_PM_ACTM_V2=y
CONFIG_LGE_PM_EXT_QG_V2=y

# MFD
CONFIG_DSV_SM5109=y

# NFC
CONFIG_LGE_NFC_PN553=y

# pstore
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# USB
CONFIG_LGE_USB_MOISTURE_DETECTION_NO_UX=y
CONFIG_LGE_USB_MOISTURE_DETECTION_USB_EN=y

# Vibrator
CONFIG_LEDS_AW8624_HAPTICS=y
