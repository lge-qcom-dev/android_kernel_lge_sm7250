# Input - fingerprint
CONFIG_BBK_ET713=y

# Input - touchscreen
CONFIG_LGE_TOUCH_FW_PATH="touch/smashjlm"
CONFIG_LGE_TOUCH_APP_FW_UPGRADE=y
CONFIG_LGE_TOUCH_MODULE_DETECT=y
CONFIG_LGE_TOUCH_SYNAPTICS_S3618=y
CONFIG_LGE_TOUCH_SYNAPTICS_S3706_SMASHJ=y

# LGE
CONFIG_MACH_LAGOON_SMASHJLM=y
CONFIG_MACH_LAGOON_SMASHJLM_COM1_JP=y
CONFIG_LGE_PM_ACTM_V2=y
CONFIG_LGE_PM_EXT_QG_V2=y

# NFC
CONFIG_LGE_NFC_SN100X=y

# pstore
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# USB
CONFIG_LGE_USB_DEBUGGER=y
CONFIG_LGE_USB_SBU_SWITCH=y

# Vibrator
CONFIG_TSPDRV=y
CONFIG_VIB_DW7800=y
